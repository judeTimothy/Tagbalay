[sub_resource type="Shader" id="Shader_g722q"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;

// ─────────────────────────────────────────────
// Distortion
// ─────────────────────────────────────────────

uniform float fisheye_strength : hint_range(0.01, 4.0, 0.01) = 1.0;

uniform float curve_scale : hint_range(0.5, 2.0, 0.01) = 1.1;
uniform float curve_x_strength : hint_range(0.0, 2.0, 0.01) = 1.0;
uniform float curve_y_strength : hint_range(0.0, 2.0, 0.01) = 1.0;
uniform float curve_x_power : hint_range(0.1, 10.0, 0.1) = 2.0;
uniform float curve_y_power : hint_range(0.1, 10.0, 0.1) = 2.0;
uniform float curve_border : hint_range(0.0, 0.2, 0.001) = 0.04;
uniform float curve_zoom : hint_range(0.5, 1.2, 0.01) = 0.92;
uniform int curve_iterations : hint_range(1, 4, 1) = 2;


// ─────────────────────────────────────────────
// Chromatic aberration / RGB separation
// ─────────────────────────────────────────────

uniform float chromatic_r_offset : hint_range(-0.02, 0.02, 0.0001) = 0.001;
uniform float chromatic_g_offset : hint_range(-0.02, 0.02, 0.0001) = 0.000;
uniform float chromatic_b_offset : hint_range(-0.02, 0.02, 0.0001) = -0.002;

uniform float chromatic_y_r : hint_range(-0.02, 0.02, 0.0001) = 0.001;
uniform float chromatic_y_g : hint_range(-0.02, 0.02, 0.0001) = -0.002;
uniform float chromatic_y_b : hint_range(-0.02, 0.02, 0.0001) = 0.000;

uniform float chromatic_intensity : hint_range(0.0, 2.0, 0.01) = 1.0;


// ─────────────────────────────────────────────
// CRT glow / color
// ─────────────────────────────────────────────

uniform float color_mix : hint_range(0.0, 2.0, 0.01) = 0.6;
uniform float color_squared_mix : hint_range(0.0, 2.0, 0.01) = 0.4;
uniform float color_bias : hint_range(0.0, 0.5, 0.01) = 0.05;

uniform vec3 color_tint : source_color = vec3(0.95, 1.05, 0.95);
uniform float brightness : hint_range(0.0, 5.0, 0.01) = 2.8;


// ─────────────────────────────────────────────
// Vignette
// ─────────────────────────────────────────────

uniform float vignette_strength : hint_range(0.0, 3.0, 0.01) = 1.0;
uniform float vignette_power : hint_range(0.01, 2.0, 0.01) = 0.3;


// ─────────────────────────────────────────────
// Scanlines
// ─────────────────────────────────────────────

uniform float scanline_speed : hint_range(0.0, 10.0, 0.1) = 3.5;
uniform float scanline_frequency : hint_range(0.0, 10.0, 0.1) = 1.5;
uniform float scanline_min : hint_range(0.0, 1.0, 0.01) = 0.35;
uniform float scanline_amplitude : hint_range(0.0, 1.0, 0.01) = 0.35;
uniform float scanline_power : hint_range(0.1, 5.0, 0.1) = 1.7;
uniform float scanline_darkness : hint_range(0.0, 2.0, 0.01) = 0.7;
uniform float scanline_brightness : hint_range(0.0, 2.0, 0.01) = 0.4;


// ─────────────────────────────────────────────
// Screen noise / flicker
// ─────────────────────────────────────────────

uniform float flicker_strength : hint_range(0.0, 0.2, 0.001) = 0.01;
uniform float flicker_speed : hint_range(0.0, 300.0, 1.0) = 110.0;


// ─────────────────────────────────────────────
// Pixel / shadow-mask effect
// ─────────────────────────────────────────────

uniform float pixel_effect_strength : hint_range(0.0, 1.0, 0.01) = 0.65;
uniform float pixel_effect_scale : hint_range(0.1, 10.0, 0.1) = 2.0;


// ─────────────────────────────────────────────
// Secondary chromatic glow
// ─────────────────────────────────────────────

uniform float glow_scale : hint_range(0.0, 2.0, 0.01) = 0.75;
uniform float glow_r_offset : hint_range(-0.1, 0.1, 0.001) = 0.025;
uniform float glow_g_offset : hint_range(-0.1, 0.1, 0.001) = -0.022;
uniform float glow_b_offset : hint_range(-0.1, 0.1, 0.001) = -0.020;

uniform float glow_r_y : hint_range(-0.1, 0.1, 0.001) = -0.027;
uniform float glow_g_y : hint_range(-0.1, 0.1, 0.001) = -0.020;
uniform float glow_b_y : hint_range(-0.1, 0.1, 0.001) = -0.018;

uniform float glow_r_strength : hint_range(0.0, 1.0, 0.01) = 0.08;
uniform float glow_g_strength : hint_range(0.0, 1.0, 0.01) = 0.05;
uniform float glow_b_strength : hint_range(0.0, 1.0, 0.01) = 0.08;


// ─────────────────────────────────────────────
// Functions
// ─────────────────────────────────────────────

vec2 fisheye(vec2 uv) {
	vec2 d = uv - 0.5;
	float r = length(d);

	float rf = pow(r, fisheye_strength)
		/ pow(0.5, fisheye_strength - 1.0);

	return vec2(0.5) + rf * normalize(d);
}


vec2 curve(vec2 uv) {
	uv = (uv - 0.5) * 2.0;

	uv *= curve_scale;

	uv.x *= 1.0 + curve_x_strength *
		pow(abs(uv.y) / 5.0, curve_x_power);

	uv.y *= 1.0 + curve_y_strength *
		pow(abs(uv.x) / 4.0, curve_y_power);

	uv = (uv / 2.0) + 0.5;

	uv = uv * curve_zoom + curve_border;

	return uv;
}


// ─────────────────────────────────────────────
// Fragment
// ─────────────────────────────────────────────

void fragment() {
	vec2 iResolution = 1.0 / SCREEN_PIXEL_SIZE;
	vec2 q = FRAGCOORD.xy / iResolution.xy;

	// Fisheye
	q = fisheye(q);

	// CRT screen curvature
	vec2 uv = q;

	for (int i = 0; i < curve_iterations; i++) {
		uv = curve(uv);
	}

	// Base screen color
	vec3 oricol = texture(screen_texture, q).xyz;
	vec3 col;

	// Animated horizontal distortion
	float x =
		sin(0.3 * TIME + uv.y * 21.0) *
		sin(0.7 * TIME + uv.y * 29.0) *
		sin(0.3 + 0.33 * TIME + uv.y * 31.0) *
		0.0017;

	// RGB-separated sampling
	col.r = texture(
		screen_texture,
		vec2(x + uv.x + chromatic_r_offset, uv.y + chromatic_y_r)
	).x;

	col.g = texture(
		screen_texture,
		vec2(x + uv.x + chromatic_g_offset, uv.y + chromatic_y_g)
	).y;

	col.b = texture(
		screen_texture,
		vec2(x + uv.x + chromatic_b_offset, uv.y + chromatic_y_b)
	).z;

	// Secondary RGB glow
	col.r += glow_r_strength * texture(
		screen_texture,
		glow_scale * vec2(x + glow_r_offset, glow_r_y)
		+ vec2(uv.x + chromatic_r_offset, uv.y + chromatic_y_r)
	).x;

	col.g += glow_g_strength * texture(
		screen_texture,
		glow_scale * vec2(x + glow_g_offset, glow_g_y)
		+ vec2(uv.x + chromatic_g_offset, uv.y + chromatic_y_g)
	).y;

	col.b += glow_b_strength * texture(
		screen_texture,
		glow_scale * vec2(x + glow_b_offset, glow_b_y)
		+ vec2(uv.x + chromatic_b_offset, uv.y + chromatic_y_b)
	).z;

	// Color / CRT glow
	col += color_bias;

	col = clamp(
		col * color_mix +
		color_squared_mix * col * col,
		0.0,
		1.0
	);

	// Vignette
	float vig =
		vignette_strength *
		16.0 *
		uv.x *
		uv.y *
		(1.0 - uv.x) *
		(1.0 - uv.y);

	col *= vec3(pow(max(vig, 0.0), vignette_power));

	// CRT tint and brightness
	col *= color_tint;
	col *= brightness;

	// Scanlines
	float scans = clamp(
		scanline_min +
		scanline_amplitude *
		sin(
			scanline_speed * TIME +
			uv.y * iResolution.y * scanline_frequency
		),
		0.0,
		1.0
	);

	float s = pow(scans, scanline_power);

	col *= vec3(
		scanline_brightness +
		scanline_darkness * s
	);

	// Subtle flicker
	col *= 1.0 +
		flicker_strength *
		sin(flicker_speed * TIME);

	// Clip outside curved screen
	if (uv.x < 0.0 || uv.x > 1.0)
		col *= 0.0;

	if (uv.y < 0.0 || uv.y > 1.0)
		col *= 0.0;

	// Pixel / shadow-mask effect
	float pixel_mask = clamp(
		(mod(FRAGCOORD.x, pixel_effect_scale) - 1.0) * 2.0,
		0.0,
		1.0
	);

	col *= 1.0 - pixel_effect_strength * vec3(pixel_mask);

	COLOR = vec4(col, 1.0);
}"

