suspicion_weight = 0.7
is_red_herring = false

[sub_resource type="TellData" id="Tell2"]
tell_id = "predator_vague"
tell_text = "When you ask which side of the family he's from, he laughs it off instead of answering."
tell_type = "overexplain"
suspicion_weight = 0.8
is_red_herring = false

