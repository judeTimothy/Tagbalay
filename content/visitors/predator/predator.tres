[gd_resource type="VisitorProfile" load_steps=4 format=3]

[sub_resource type="VisitorLine" id="Greet1"]
text = "Ay, hi! Pinsan ako ni Nanay mo, galing probinsya. Pwede ko lang po hintayin dito yung sundo ko? Malamig sa labas."
trigger_condition = "on_greet"

[sub_resource type="TellData" id="Tell1"]
tell_id = "predator_urgency"
tell_text = "He keeps glancing at the street behind him, not at you — like he's timing something."
