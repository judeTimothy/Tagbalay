[gd_resource type="VisitorProfile" load_steps=5 format=3]

[sub_resource type="VisitorLine" id="Greet1"]
text = "Ma'am/Sir, good evening po. Kumusta na po yung balance ninyo?"
trigger_condition = "on_greet"

[sub_resource type="TellData" id="Tell1"]
tell_id = "legit_rey_hesitation"
tell_text = "He checks a small notebook before answering your question — like he's making sure he has the numbers right, not making them up."
tell_type = "hesitation"
suspicion_weight = 0.1
is_red_herring = true

[sub_resource type="TellData" id="Tell2"]
tell_id = "legit_rey_tired"
tell_text = "He sounds tired, almost apologetic about being here this late — like this isn't the part of the job he enjoys."
tell_type = "tone_mismatch"
suspicion_weight = 0.1
is_red_herring = true

[sub_resource type="VisitorLine" id="RefuseResp1"]
text = "Sige po. Babalik na lang ako. Pero tataas po ito, ha."
trigger_condition = "on_refuse"

[resource]
visitor_id = "legit_manong_rey"
display_name = "Manong Rey"
visitor_type = 0
greet_lines = [SubResource("Greet1")]
tell_pool = [SubResource("Tell1"), SubResource("Tell2")]
tells_per_visit = 2
response_lines = {
"REFUSE": [SubResource("RefuseResp1")]
}
base_aggression = 0.2
debt_knowledge_accurate = true
wants_entry_not_payment = false
can_be_paid = true
safe_if_refused = true
safe_if_paid = true
fatal_if_let_in = false
linked_person_id = ""
